APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

DB_NAME=sw_be
DB_USERNAME=swbe
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-another-strong-password

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

MAIL_USERNAME=<발신용 Gmail 주소>
MAIL_PASSWORD=<Gmail 앱 비밀번호>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_FROM=<발신용 Gmail 주소>

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax

MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=50MB
MULTIPART_MAX_PART_HEADER_SIZE=8KB
AWS_REGION=ap-northeast-2
S3_BUCKET=<S3 버킷명>
CLOUDFRONT_BASE_URL=https://<CloudFront 도메인>

DEPLOY_HOST=<Linux 서버 IP 또는 호스트명>
DEPLOY_PORT=22
DEPLOY_USER=<SSH 사용자>
DEPLOY_PATH=/opt/sw-be
DEPLOY_SSH_KEY=<SSH 개인키 전체 내용>
DEPLOY_KNOWN_HOSTS=<서버 SSH host key>

GHCR_USERNAME=<GitHub 사용자명>
GHCR_READ_TOKEN=<read:packages 권한의 GitHub PAT>
